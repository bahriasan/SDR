- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.decim_block):\n\
      \    def __init__(self, window_size=4096):\n        self.window_size = int(window_size)\n\
      \n        if self.window_size <= 0:\n            raise ValueError(\"window_size\
      \ must be positive\")\n\n        gr.decim_block.__init__(\n            self,\n\
      \            name=\"SNR Meter Optimized\",\n            in_sig=[np.complex64,\
      \ np.complex64],\n            out_sig=[np.float32],\n            decim=self.window_size\n\
      \        )\n\n    def work(self, input_items, output_items):\n        signal\
      \ = input_items[0]\n        noise = input_items[1]\n        output = output_items[0]\n\
      \n        n_windows = min(\n            len(output),\n            len(signal)\
      \ // self.window_size,\n            len(noise) // self.window_size\n       \
      \ )\n\n        if n_windows == 0:\n            return 0\n\n        n = n_windows\
      \ * self.window_size\n\n        s = signal[:n].reshape(n_windows, self.window_size)\n\
      \        w = noise[:n].reshape(n_windows, self.window_size)\n\n        # |x|^2\
      \ = Re(x)^2 + Im(x)^2\n        signal_power = np.sum(\n            s.real *\
      \ s.real + s.imag * s.imag,\n            axis=1,\n            dtype=np.float64\n\
      \        ) / self.window_size\n\n        noise_power = np.sum(\n           \
      \ w.real * w.real + w.imag * w.imag,\n            axis=1,\n            dtype=np.float64\n\
      \        ) / self.window_size\n\n        with np.errstate(divide=\"ignore\"\
      , invalid=\"ignore\"):\n            output[:n_windows] = (\n               \
      \ 10.0 * np.log10(signal_power / noise_power)\n            ).astype(np.float32)\n\
      \n        return n_windows\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    window_size: '4096'
  states:
    _io_cache: ('SNR Meter Optimized', 'blk', [('window_size', '4096')], [('0', 'complex',
      1), ('1', 'complex', 1)], [('0', 'float', 1)], '', ['window_size'])
